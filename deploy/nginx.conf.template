# nginx перед приложением. ${SERVER_NAME} подставляется при старте контейнера (envsubst).

server_tokens off;

# Частота запросов с одного IP. Точные лимиты (на номер, логин, аккаунт) — в приложении; здесь — грубый
# фильтр от перебора и флуда, с запасом на мобильный NAT, где за одним адресом много людей.
limit_req_zone $binary_remote_addr zone=auth:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=api:20m rate=30r/s;
limit_req_status 429;
limit_conn_zone $binary_remote_addr zone=conn:10m;
limit_conn_status 429;

# Карта OpenFreeMap через свой сервер (/ofm/…): стиль, тайлы, шрифты и значки — с копией на диске (до 5 ГБ, том mapcache).
# Браузер посетителя обращается только к нашему сайту; наружу уходит лишь адрес тайла — без IP, cookie и заголовков.
proxy_cache_path /var/cache/nginx/map levels=1:2 keys_zone=map:20m max_size=5g inactive=90d use_temp_path=off;

# Запросы на IP или чужое имя (сканеры, подмена Host) — без ответа; на 443 — даже без рукопожатия TLS.
server {
  listen 80 default_server;
  listen 443 ssl default_server;
  ssl_reject_handshake on;
  return 444;
}

server {
  listen 80;
  server_name ${SERVER_NAME} www.${SERVER_NAME};
  # Продление сертификата Let's Encrypt (certbot renew --webroot).
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://${SERVER_NAME}$request_uri; }
}

# www → адрес без www. Сертификат включает www, если www-запись указывает на сервер (deploy/launch.sh);
# иначе сюда никто и не приходит.
server {
  listen 443 ssl;
  http2 on;
  server_name www.${SERVER_NAME};
  ssl_certificate     /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
  return 301 https://${SERVER_NAME}$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${SERVER_NAME};

  ssl_certificate     /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;

  # Сайт закрыт (bash deploy/site.sh off): всем — страница «Сайт временно не работает», код 503.
  # Файл проверяется при каждом запросе — переключение без перезапуска. Продление сертификата идёт через порт 80 и не затронуто.
  if (-f /srv/site-off/on) { return 503; }
  error_page 503 @site_off;
  location @site_off {
    root /srv/site-off;
    try_files /index.html =503;
    add_header Cache-Control "no-store" always;
    add_header Retry-After 3600 always;
  }
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  ssl_session_tickets off;

  # Фото до 8 МБ (+ запас на multipart).
  client_max_body_size 10m;

  # IP клиента — справа в X-Forwarded-For (TRUST_PROXY_HOPS=1); адрес сайта для проверки Origin приложение берёт из PUBLIC_URL.
  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  # Эти заголовки от клиента не пропускаем: адрес сайта приложение берёт из PUBLIC_URL, IP — из X-Forwarded-For.
  proxy_set_header X-Forwarded-Host "";
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header Connection "";

  # Живые обновления (SSE): без буферизации и с долгим чтением.
  location = /api/stream {
    limit_conn conn 20;
    proxy_pass http://app:3000;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }

  # Карта OpenFreeMap — через этот сервер с кэшем (см. proxy_cache_path выше). Адреса в стиле и описании тайлов
  # переписываются на наш сайт. Имя хоста — через переменную: разрешается при запросе, и nginx стартует, даже если
  # OpenFreeMap недоступен (карта тогда берётся из кэша).
  location /ofm/ {
    limit_except GET { deny all; }
    resolver 127.0.0.11 valid=300s ipv6=off;
    resolver_timeout 5s;
    set $ofm tiles.openfreemap.org;
    rewrite ^/ofm(/.*)$ $1 break;
    proxy_pass https://$ofm;
    proxy_ssl_server_name on;
    proxy_ssl_name tiles.openfreemap.org;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_http_version 1.1;
    # Ничего от посетителя не передаём: ни cookie, ни IP, ни адреса страницы, ни браузера.
    proxy_pass_request_headers off;
    proxy_set_header Host tiles.openfreemap.org;
    proxy_set_header User-Agent "${SERVER_NAME} map cache";
    proxy_set_header Accept-Encoding "";
    proxy_set_header Connection "";
    proxy_hide_header Set-Cookie;
    proxy_ignore_headers Set-Cookie;
    proxy_cache map;
    proxy_cache_key $uri;
    proxy_cache_valid 200 30d;
    proxy_cache_valid 404 1m;
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    proxy_cache_lock on;
    proxy_connect_timeout 10s;
    proxy_read_timeout 30s;
    sub_filter 'https://tiles.openfreemap.org/' 'https://${SERVER_NAME}/ofm/';
    sub_filter_once off;
    sub_filter_types application/json;
  }

  # Своя карта (deploy/map-setup.mjs): стиль, шрифты, значки и файл тайлов .pmtiles — карта читает его
  # Range-запросами, nginx отдаёт куски файла сам.
  location /map/ {
    alias /srv/map/;
    add_header Cache-Control "public, max-age=86400";
    add_header X-Content-Type-Options nosniff;
  }

  # Вход, регистрация, коды: перебор паролей и кодов.
  location /api/auth/ {
    limit_req zone=auth burst=30 nodelay;
    proxy_pass http://app:3000;
  }

  location /api/ {
    limit_req zone=api burst=60 nodelay;
    proxy_pass http://app:3000;
    proxy_read_timeout 60s;
  }

  # Статика сборки — с хешем в имени, кэшируется навсегда.
  location /_next/static/ {
    proxy_pass http://app:3000;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    proxy_pass http://app:3000;
    proxy_read_timeout 60s;
  }
}
