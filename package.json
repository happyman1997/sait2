{
  "name": "arena-raboty",
  "version": "0.1.0",
  "private": true,
  "description": "Арена Работы — платформа сезонных смен на карте",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "cron": "node --env-file-if-exists=.env.local --import tsx scripts/cron.ts",
    "ads": "node --env-file-if-exists=.env.local --import tsx scripts/ads.ts",
    "staff": "node --env-file-if-exists=.env.local --import tsx scripts/staff.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "maplibre-gl": "^4.7.1",
    "next": "^16.3.6",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
