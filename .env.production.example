# Продакшен: скопируйте в .env.production и заполните. Файл с секретами в git не кладётся.

# ── Обязательно ──
# Домен сайта (на него выпускается сертификат) и адрес для ссылок в письмах.
SERVER_NAME=arena-raboty.ru
PUBLIC_URL=https://arena-raboty.ru
# Пароль базы: openssl rand -hex 24
POSTGRES_PASSWORD=
# Ключ для кодов подтверждения: openssl rand -hex 32
AUTH_CODE_SECRET=

# SMS: smsru (SMSRU_API_ID из личного кабинета SMS.ru) | console — коды в журнал приложения (только для стенда)
SMS_PROVIDER=smsru
SMSRU_API_ID=
# Письма: smtp | console
EMAIL_PROVIDER=smtp
SMTP_URL=smtps://no-reply%40arena-raboty.ru:ПАРОЛЬ@smtp.yandex.ru:465
EMAIL_FROM=Арена Работы <no-reply@arena-raboty.ru>
SUPPORT_EMAIL=support@arena-raboty.ru

# Геокодер: свой Nominatim/Photon (публичный OSM — 1 запрос/с, не для продакшена)
GEOCODER_URL=https://nominatim.example.ru
GEOCODER_USER_AGENT=arena-raboty/1.0 (admin@arena-raboty.ru)

# ── Желательно ──
# Веб-пуш: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@arena-raboty.ru
# Метрики Prometheus (/api/metrics с заголовком Authorization: Bearer …): openssl rand -hex 24
METRICS_TOKEN=

# ── По умолчанию подходит ──
APP_TIME_ZONE=Europe/Moscow
# Стиль карты попадает в сборку; другие хосты тайлов — в CSP_CONNECT_SRC через пробел
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
CSP_CONNECT_SRC=
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
# Фото в S3 (нужно, если экземпляров приложения несколько); пусто — том uploads
S3_BUCKET=
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Порты и сертификаты (обычно не трогать)
HTTP_PORT=80
HTTPS_PORT=443
LETSENCRYPT_DIR=/etc/letsencrypt
