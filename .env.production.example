# Продакшен: скопируйте в .env.production и заполните. Файл с секретами в git не кладётся.

# ── Обязательно ──
# Домен сайта (на него выпускается сертификат) и адрес для ссылок в письмах.
SERVER_NAME=arenarabot.ru
PUBLIC_URL=https://arenarabot.ru
# Пароль базы: openssl rand -hex 24
POSTGRES_PASSWORD=
# Ключ для кодов подтверждения: openssl rand -hex 32
AUTH_CODE_SECRET=

# Письма: коды подтверждения при регистрации и восстановлении пароля, уведомления. Только smtp — без почты не войти.
EMAIL_PROVIDER=smtp
# Один ящик info@ (support@ и privacy@ — его бесплатные алиасы в Яндекс 360). Проще заполнить: bash deploy/configure.sh
SMTP_URL=smtps://info%40arenarabot.ru:ПАРОЛЬ@smtp.yandex.ru:465
EMAIL_FROM=Арена Работ <info@arenarabot.ru>
SUPPORT_EMAIL=support@arenarabot.ru

# Вход через Яндекс ID и VK ID — по желанию (DEPLOY.md, раздел 12). Пусто — кнопки не показываются.
# Яндекс: ClientID и Client secret приложения на oauth.yandex.ru. Секрет — только сюда, никому не пересылайте.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# VK ID: ID приложения на id.vk.com (только цифры). Секрет VK для входа не нужен.
VK_CLIENT_ID=

# Яндекс Метрика — по желанию (DEPLOY.md, раздел 14): номер счётчика, только цифры. Пусто — счётчика и окна о статистике нет.
# Счётчик включается у посетителя только после «Разрешить» в окне о статистике.
YANDEX_METRIKA_ID=

# Telegram-канал — по желанию (DEPLOY.md, раздел 15): раз в день бот публикует сводку открытых заказов.
# Вписывается вопросами в deploy/configure.sh. Ключ бота — секрет, никому не пересылайте.
TELEGRAM_CHANNEL=
TELEGRAM_BOT_TOKEN=
# Час публикации по Москве (по умолчанию 19) и город, вокруг которого брать заказы (пусто — все города; радиус — 50 км).
TELEGRAM_DIGEST_HOUR=
TELEGRAM_DIGEST_CITY=

# Поиск адреса на карте: DaData (dadata.ru → личный кабинет → «API-ключ»; бесплатно до 10 000 запросов в сутки).
# Вписывается вопросом в deploy/configure.sh. Без ключа поиск адреса не работает — метку ставят кликом по карте.
DADATA_API_KEY=
# Вместо DaData — свой Nominatim-совместимый геокодер (публичный OSM — 1 запрос/с, только для разработки)
GEOCODER_URL=
GEOCODER_USER_AGENT=arena-raboty/1.0 (admin@arenarabot.ru)

# Реквизиты оператора ПДн — подставляются в оферту, политику, согласие (/legal/*). Обязательны: без них сайт
# не запустится и напишет в журнал, что не заполнено (server/startup-check.ts).
OPERATOR_NAME=
OPERATOR_OGRNIP=
OPERATOR_INN=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=privacy@arenarabot.ru
# Сводка по запросу (bash deploy/digest.sh --mail) уходит на OPERATOR_EMAIL; другой адрес — DIGEST_EMAIL.
# DIGEST_EMAIL=
# Подтверждение сайта в Яндекс.Вебмастере и Google Search Console: код из их мета-тега (content="…"), не секрет.
# Код Яндекса для arenarabot.ru уже встроен; задавайте, только если адрес сайта другой.
# YANDEX_VERIFICATION=
# GOOGLE_SITE_VERIFICATION=
# После внесения в реестр операторов Роскомнадзора (до этого строка в политике не показывается)
OPERATOR_RKN_NUMBER=
# Обработчики по поручению — юрлицо и ИНН из их договора-оферты, например: ООО «Хостинг», ИНН 0000000000.
# PROCESSOR_STORAGE — облачное хранилище (Yandex Object Storage и т. п.), если в нём фото (S3_BUCKET) или копии (BACKUP_S3_BUCKET).
PROCESSOR_HOSTING=
PROCESSOR_MAIL=
PROCESSOR_STORAGE=

# ── Желательно ──
# Веб-пуш: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@arenarabot.ru
# Метрики Prometheus (/api/metrics с заголовком Authorization: Bearer …): openssl rand -hex 24
METRICS_TOKEN=

# ── По умолчанию подходит ──
APP_TIME_ZONE=Europe/Moscow
# Стиль карты попадает в сборку. По умолчанию — карта OpenFreeMap через свой nginx с копией на диске (/ofm/…):
# браузер посетителя обращается только к вашему сайту. Свой файл тайлов (DEPLOY.md, «Своя карта») — /map/style.json.
# Другие хосты тайлов (если стиль внешний) — в CSP_CONNECT_SRC через пробел.
NEXT_PUBLIC_MAP_STYLE_URL=/ofm/styles/liberty
CSP_CONNECT_SRC=
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
# Фото в S3 (нужно, если экземпляров приложения несколько); пусто — том uploads
S3_BUCKET=
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Копии базы и фото — в хранилище (deploy/backup.sh, DEPLOY.md раздел 6). Пусто — бакет и ключ S3_* выше.
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Порты и сертификаты (обычно не трогать)
HTTP_PORT=80
HTTPS_PORT=443
LETSENCRYPT_DIR=/etc/letsencrypt
