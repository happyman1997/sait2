# Продакшен: скопируйте в .env.production и заполните. Файл с секретами в git не кладётся.

# ── Обязательно ──
# Домен сайта (на него выпускается сертификат) и адрес для ссылок в письмах.
SERVER_NAME=arenarabot.ru
PUBLIC_URL=https://arenarabot.ru
# Пароль базы: openssl rand -hex 24
POSTGRES_PASSWORD=
# Ключ для кодов подтверждения: openssl rand -hex 32
AUTH_CODE_SECRET=

# SMS: smsru (SMSRU_API_ID из личного кабинета SMS.ru) | console — коды в журнал приложения (только для стенда)
SMS_PROVIDER=smsru
SMSRU_API_ID=
# Потолок SMS в сутки на весь сайт (коды и уведомления). Дополнительно задайте лимит расходов в кабинете SMS.ru.
SMS_DAILY_LIMIT=300
# Письма: smtp | console
EMAIL_PROVIDER=smtp
SMTP_URL=smtps://no-reply%40arenarabot.ru:ПАРОЛЬ@smtp.yandex.ru:465
EMAIL_FROM=Арена Работы <no-reply@arenarabot.ru>
SUPPORT_EMAIL=support@arenarabot.ru

# Геокодер: свой Nominatim/Photon (публичный OSM — 1 запрос/с, не для продакшена)
GEOCODER_URL=https://nominatim.example.ru
GEOCODER_USER_AGENT=arena-raboty/1.0 (admin@arenarabot.ru)

# Реквизиты оператора ПДн — подставляются в оферту, политику, согласие (/legal/*). Обязательны: без них сайт
# не запустится и напишет в журнал, что не заполнено (server/startup-check.ts).
OPERATOR_NAME=
OPERATOR_OGRNIP=
OPERATOR_INN=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=privacy@arenarabot.ru
# После внесения в реестр операторов Роскомнадзора (до этого строка в политике не показывается)
OPERATOR_RKN_NUMBER=
# Обработчики по поручению — юрлицо и ИНН из их договора-оферты, например: ООО «Хостинг», ИНН 0000000000.
# PROCESSOR_STORAGE — только если фото в S3 (S3_BUCKET); без S3 фото хранятся у хостинга.
PROCESSOR_HOSTING=
PROCESSOR_SMS=
PROCESSOR_MAIL=
PROCESSOR_STORAGE=

# ── Желательно ──
# Веб-пуш: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@arenarabot.ru
# Метрики Prometheus (/api/metrics с заголовком Authorization: Bearer …): openssl rand -hex 24
METRICS_TOKEN=

# ── По умолчанию подходит ──
APP_TIME_ZONE=Europe/Moscow
# Стиль карты попадает в сборку. Своя карта (DEPLOY.md, «Своя карта») — /map/style.json;
# по умолчанию — OpenFreeMap (за рубежом). Другие хосты тайлов — в CSP_CONNECT_SRC через пробел.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
CSP_CONNECT_SRC=
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
# Фото в S3 (нужно, если экземпляров приложения несколько); пусто — том uploads
S3_BUCKET=
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Копии базы и фото — в хранилище (deploy/backup.sh, DEPLOY.md раздел 6). Пусто — бакет и ключ S3_* выше.
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Порты и сертификаты (обычно не трогать)
HTTP_PORT=80
HTTPS_PORT=443
LETSENCRYPT_DIR=/etc/letsencrypt
