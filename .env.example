# Postgres (серверы в РФ — требование 152-ФЗ)
DATABASE_URL=postgres://arena:arena@localhost:5432/arena_dev

# Секрет для HMAC кодов подтверждения (обязателен в продакшене): openssl rand -hex 32
AUTH_CODE_SECRET=

# Провайдер SMS: console (код в лог сервера, по умолчанию в dev) | smsru
SMS_PROVIDER=console
SMSRU_API_ID=

# Только для разработки: фиксированный код вместо случайного (например, 1234 как в прототипе)
SMS_DEV_FIXED_CODE=

# Secure-cookie (по умолчанию 1 в продакшене)
# SECURE_COOKIES=1

# Геокодер: Nominatim-совместимый API. Публичный nominatim.openstreetmap.org — только для разработки
# (лимит 1 запрос/с, обязателен User-Agent). В продакшене — свой Nominatim или Photon на серверах в РФ.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=arena-raboty/0.1 (admin@example.ru)

# Стиль карты MapLibre (OpenFreeMap liberty по умолчанию; можно свой хостинг тайлов)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Сколько доверенных прокси перед приложением (IP клиента берётся из X-Forwarded-For справа). 0 — не доверять заголовку.
TRUST_PROXY_HOPS=1

# Фоновые задачи (автоприёмка через 7 дней, очистка) запускаются в процессе раз в 10 минут.
# 1 — отключить и вызывать `npm run cron` внешним планировщиком.
DISABLE_SCHEDULER=
